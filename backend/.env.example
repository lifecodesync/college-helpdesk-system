# ==============================================================================
# AI-Based College Helpdesk and Student Assistance System
# Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="AI College Helpdesk API"
API_V1_PREFIX="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Supabase Configuration
# Obtain from: Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI / LLM Configuration
# Supports Google Gemini API (gemini-1.5-flash / gemini-2.0-flash / gemini-pro)
GEMINI_API_KEY="your-gemini-api-key"
EMBEDDING_MODEL="models/text-embedding-004"
LLM_MODEL="gemini-1.5-flash"

# JWT Auth Secret
JWT_SECRET="college-helpdesk-super-secret-jwt-key-2026-cse-project"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
